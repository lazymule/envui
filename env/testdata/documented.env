# Example settings (DMVC wizard style). Copy this file to ".env".
# The API reads all its settings from here.

# ============================================================================
# Server
# ============================================================================
dmvc.server.port=8085
# Address Swagger sends requests to
dmvc.swagger.host=localhost:8085

# ============================================================================
# Database (SQL Server login;
# Windows authentication is not used)
# ============================================================================
# Server: name or name\instance (e.g. .\SQL17)
db.server=localhost
db.database=App
# User and password are required. If the password contains #, $ or quotes,
# write it in single quotes: 'p#ro'
db.username=
db.password=

# === Logging ===
logger.level=debug # debug, info, warning
dmvc.analytics.folder=logs\analytics
# only in DEBUG builds:
# dev.lisans.web=5
