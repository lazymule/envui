// Windows resources for envui.exe (icon + version info).
// Rebuild rsrc_windows_amd64.syso after changing this file:
//   x86_64-w64-mingw32-windres -O coff -i winres/envui.rc -o rsrc_windows_amd64.syso

#include <winver.h>

1 ICON "envui.ico"

1 VERSIONINFO
FILEVERSION     0,3,0,0
PRODUCTVERSION  0,3,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription",  "envui - .env file editor"
      VALUE "ProductName",      "envui"
      VALUE "FileVersion",      "0.3.0"
      VALUE "ProductVersion",   "0.3.0"
      VALUE "OriginalFilename", "envui.exe"
      VALUE "LegalCopyright",   "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
